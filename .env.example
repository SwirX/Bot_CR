# ════════════════════════════════════════════════
#  Bot_CR environment configuration template
#  Copy this file to .env and fill in your values.
#  .env is git-ignored - never commit real secrets.
# ════════════════════════════════════════════════

# ── Discord bot token (REQUIRED) ─────────────────────────────
# From https://discord.com/developers/applications -> your app -> Bot -> Token
BOT_TOKEN=CHANGE_ME_YOUR_BOT_TOKEN

# Command prefix (used side-by-side with slash commands)
PREFIX=!

# Server (guild) ID for instant slash-command sync.
# Leave empty to sync commands globally (can take up to an hour to propagate).
# Get your server ID: right-click your server icon -> Copy Server ID.
GUILD_ID=

# ── Appwrite data store (REQUIRED) ───────────────────────────
# Self-hosted Appwrite endpoint (keep the /v1 suffix).
APPWRITE_ENDPOINT=https://appwrite.alibks.dev/v1
# Project ID from Appwrite console -> Project Settings.
APPWRITE_PROJECT_ID=robotics-ops
# API key with databases read/write scopes (Appwrite console -> API Keys).
APPWRITE_API_KEY=
# Database that holds the bot collections (autocreated if missing).
APPWRITE_DATABASE_ID=robotics_ops

# ── Channel names (channel @name or #name on the server) ─────
CHANNEL_RULES=•📚•-rules-of-the-server
CHANNEL_WELCOME=•👋•-joins
CHANNEL_GOODBYE=•👋•-leaves
CHANNEL_VERIFICATION=•📑•-verification
CHANNEL_ANNOUNCEMENTS=⦿announcements⦿
CHANNEL_DASHBOARD=⦿dashboard⦿
CHANNEL_BOTLOG=🤖bot-development

# ── Role names ───────────────────────────────────────────────
ROLE_TEMP=⛔ | None
ROLE_VERIFIED=「📗」Verified
ROLE_MEMBER=🌿 | LVL 01+

# ── Behaviour ────────────────────────────────────────────────
# Dashboard embed refresh interval (seconds).
DASHBOARD_REFRESH_SECONDS=60

# ── Club website (shown by /website) ─────────────────────────
WEBSITE_URL=https://robotics.ma

# ── KeepAlive web server port (free-host pings) ──────────────
PORT=8080